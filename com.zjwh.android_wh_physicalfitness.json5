// ============================================================================
// 运动世界校园 7.3.93 (com.zjwh.android_wh_physicalfitness) —— GKD 本地应用规则
//
// 导入：GKD → 订阅 → 本地订阅 → 应用规则 → + ，整段粘贴
// 用途：补齐广告页关闭按钮、开屏「跳过」兜底与返回键兜底。
// 前提：安装 GKD 并开启无障碍；建议同时导入续更订阅
//       Lin-arm/GKD_subscription，并关闭其 key 13 / 14 / 15（见 README.md）。
// 二选一：远程订阅与本地粘贴只启用一个，同时启用会重复点击。
// 回退：关闭对应规则组，或关掉 GKD 无障碍开关。
//
// 组件名与资源 ID 均对照 7.3.93 完整 AndroidManifest.xml（330 个组件）
// 与 resources.arsc 核实。activityIds / excludeActivityIds 是 startWith 匹配；
// 以 "." 开头会自动补全为 appId + 该字符串；exclude 优先级高于 activityIds。
//
// 红线：不接触跑步计时、轨迹、成绩与定位页面；不用硬编码屏幕坐标；不用跨应用
//       全局规则；不收激励视频/奖励页；不以猜坐标或尺寸代替真实节点。
//
// === 第九轮重修（version 11，2026-11-13）===
// 真机连续反馈「还是不行」后，回到静态证据与官方文档复核，确认前八轮一直在
// 做「补 vid / 放宽窗口」，却漏了三个结构性根因：
//  ① 白名单从结构上挡住了插屏。完整 manifest 330 个组件，旧白名单只覆盖 30 个；
//    136 个第三方广告/桥接容器在白名单外（华为 ads 8、快手 47、穿山甲 live 24、
//    acse.ottn 7…）。dex 里 PopupWindow x181 / DialogFragment x173 / WindowManager
//    x43 / addView x38，且京东插屏 JADInterstitial 在 manifest 中根本没有独立
//    Activity —— 它就是叠在宿主 Activity 上的浮层。开屏组 100 没有白名单所以
//    能拦，组 101/102 被白名单挡住，正好解释了「开屏能拦、几秒后弹窗拦不住」。
//  ② matchRoot。官方 RawCommonProps：GKD 默认从「无障碍事件节点」向下匹配；
//    弹窗里每秒变化的倒计时 TextView 会一直作为事件节点，关闭按钮不在它的子树，
//    「即使你能在网页审查工具查询到这个节点」也匹配失败。所有组改 matchRoot:true。
//  ③ forcedTime。官方 RawCommonProps：flutter/webview 页面变化不发
//    onAccessibilityEvent 时，只能主动轮询。本 APK 有 libflutter.so、
//    flutterEmbedding=2，广告又大量走 WebView。所有组加 forcedTime:10000。
//  另：官方 optimize#rule-format 规定 fastQuery 只接受 id/vid/text，混入
//    desc 分支会让整条 || 表达式停用快速查询。现将 vid 与泛化信号拆成组 101/103，
//    组 101 启用 fastQuery:true，78 个 vid 全部合规。
//
// === 第十轮复核（version 12，2026-11-14）===
// 对第九轮改动做量化反查（_probe/112_round10.txt），确认三处残留缺陷：
//  ① 组 103 仍用 activityIds 白名单 34 项 → 实测只覆盖 124/330 个组件，
//    自有 Activity 仅 4/140。这与第九轮「插屏是宿主上的浮层」根因自相矛盾：
//    截图里「N秒 | 关闭」与圆形 × 正是本组的泛化信号，却最可能被白名单挡住。
//    换成 41 项业务黑名单后可达 194/330（多 70 个），136/140 个自有业务页
//    仍被红线排除。
//  ② 组 102 删白名单后作用面扩到 194 个组件，选择器却仍含
//    text*="立即领取"（arsc 1 处 / dex 2 处，业务活动文案）与
//    text*="滑动查看详情"；按 back 会误退页面。已移除，并给 text*="广告"
//    加 text.length<=12，只保留 SDK 专属互动引导语。
//  ③ forcedTime 10000：官方定义为「在开始匹配后的一段时间内」主动查询；
//    组 101/103 常驻无窗口，计时起点不随队列轮播刷新。第八轮已证实
//    showMaxCacheAds / NextAd 轮播，第 2/3 条广告落在 10 秒之后 → 统一 30000。
//  另：官方 selector#attr 确认并列 [] 是同一节点 AND（[a][b] == [a&&b]），
//    optimize#rule-format 复核组 100 / 101 的 fastQuery 格式合规，均无需改动。
//
// === 必须保持的不变量（第六 / 九 / 十轮变异测试 + 结构回归）===
//  · 组 101 不得加 matchTime / actionMaximum / resetMatch：它常驻任意 Activity，
//    加窗口会重现「首页弹窗在任意时刻出现却拦不住」。
//  · 组 101 必须保留 actionCd 1500 与选择器末尾 [visibleToUser=true]。
//  · 组 101 不得混入 desc 分支，否则 fastQuery 整体失效。
//  · 四个组都不得重新引入 activityIds 白名单（第九 / 十轮根因）。
//  · 组 100/101/102/103 的 excludeActivityIds 必须覆盖全部自有业务页面。
//  · 组 103 不得加 text*="跳过"（与组 100 必然连点开屏按钮）。
//  · 所有组必须保留 matchRoot:true 与 forcedTime:30000（轮播第 2/3 条）。
//  · 组 102 不得重新引入 text*="立即领取" / text*="滑动查看详情"（误按返回键）。
// ============================================================================

{
  "id": "com.zjwh.android_wh_physicalfitness",
  "name": "运动世界校园 7.3.93 补充",
  "groups": [
    {
      "key": 100,
      "name": "开屏广告-跳过按钮兜底",
      // 无 activityIds 白名单：开屏宿主不能被白名单挡住。改用业务页黑名单，
      // 41 个前缀覆盖 136/140 个自有 Activity，剩下的 4 个正是广告宿主
      // （Splash / Ad / Home / KwadHandler）。
      "excludeActivityIds": [
        ".mvi.run",
        ".mvi.sport",
        ".mvi.indoor",
        ".mvi.ai",
        ".mvi.exam",
        ".mvi.course",
        ".mvi.home.plan",
        ".mvi.home.SportProgressActivity",
        ".activity.RunPlanActivity",
        ".hybrid.ui",
        ".mvi.tice",
        ".mvi.teachplan",
        ".mvi.roll",
        ".mvi.extra",
        ".mvi.appeal",
        ".mvi.survey",
        ".mvi.competition",
        ".mvi.notice",
        ".mvi.dynamic",
        ".mvi.me",
        ".mvi.setting",
        ".mvi.choose",
        ".mvi.register",
        ".mvi.login",
        ".mvi.tourist",
        ".mvi.wearable",
        ".activity.mine",
        ".mvi.home.InterestLabelActivity",
        ".mvi.home.RankingListActivity",
        ".mvi.home.rank",
        ".mvi.CustomWebViewActivity",
        ".mvi.WebViewActivity",
        ".mvi.WebViewGameActivity",
        ".mvi.VideoPlayActivity",
        ".mvi.FileReaderActivity",
        ".mvi.ImageViewerActivity",
        ".mvi.MultiImageSelectorActivity",
        ".hybrid.demo",
        ".utils.qrcode",
        ".wxapi",
        ".mvi.splash.SystemUpgradeActivity"
      ],
      "fastQuery": true,
      // 从根节点开始匹配：倒计时文本节点变化时关闭按钮仍能被找到。
      "matchRoot": true,
      // Flutter / WebView 不发无障碍事件时主动轮询 30 秒。
      "forcedTime": 30000,
      // 队列轮播（dex: showMaxCacheAds / adCache / NextAd / adQueue）同一次
      // Activity 内会连出多条广告，故 60 秒窗口 + 4 次上限；actionCd < matchTime。
      "matchTime": 60000,
      "actionMaximum": 4,
      "resetMatch": "activity",
      "actionCd": 1500,
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"跳过\"][text.length<20][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 101,
      "name": "全屏/插屏广告-关闭按钮（vid 精确匹配，全 Activity）",
      // 第九轮：删除旧 activityIds 白名单。78 个 vid 都是广告 SDK 专属资源名，
      // 用与组 100 相同的业务黑名单即可安全地在任意宿主 Activity 上生效；
      // 弹窗以 PopupWindow / DialogFragment 浮层形式叠加时也不会再被漏掉。
      "excludeActivityIds": [
        ".mvi.run",
        ".mvi.sport",
        ".mvi.indoor",
        ".mvi.ai",
        ".mvi.exam",
        ".mvi.course",
        ".mvi.home.plan",
        ".mvi.home.SportProgressActivity",
        ".activity.RunPlanActivity",
        ".hybrid.ui",
        ".mvi.tice",
        ".mvi.teachplan",
        ".mvi.roll",
        ".mvi.extra",
        ".mvi.appeal",
        ".mvi.survey",
        ".mvi.competition",
        ".mvi.notice",
        ".mvi.dynamic",
        ".mvi.me",
        ".mvi.setting",
        ".mvi.choose",
        ".mvi.register",
        ".mvi.login",
        ".mvi.tourist",
        ".mvi.wearable",
        ".activity.mine",
        ".mvi.home.InterestLabelActivity",
        ".mvi.home.RankingListActivity",
        ".mvi.home.rank",
        ".mvi.CustomWebViewActivity",
        ".mvi.WebViewActivity",
        ".mvi.WebViewGameActivity",
        ".mvi.VideoPlayActivity",
        ".mvi.FileReaderActivity",
        ".mvi.ImageViewerActivity",
        ".mvi.MultiImageSelectorActivity",
        ".hybrid.demo",
        ".utils.qrcode",
        ".wxapi",
        ".mvi.splash.SystemUpgradeActivity"
      ],
      "fastQuery": true,
      "matchRoot": true,
      "forcedTime": 30000,
      "actionCd": 1500,
      // 78 个 vid 逐个核对为 resources.arsc 中 type=id 的真实资源名；
      // 不收 *_reward_*、ad_close_*_area 与业务页通用名 btn_close / tv_close。
      // 纯 vid 分支全部符合官方 fastQuery 规定格式。
      "rules": [
        {
          "key": 0,
          "matches": "[vid=\"iv_close\" || vid=\"ad_close\" || vid=\"dialog_close\" || vid=\"over_ad_close\" || vid=\"lp_webview_iv_close\" || vid=\"baidu_wp_close\" || vid=\"jad_interstitial_close\" || vid=\"jad_banner_close\" || vid=\"jad_feed_close\" || vid=\"jad_splash_skip_btn\" || vid=\"jd_close\" || vid=\"jd_lijin_close\" || vid=\"jdwm_close\" || vid=\"tianmu_suspend_iv_close\" || vid=\"tianmu_iv_close\" || vid=\"tianmu_tv_close\" || vid=\"tianmu_banner_iv_close\" || vid=\"tianmu_widget_iv_close\" || vid=\"adgain_interstitial_close_ll\" || vid=\"adgain_interstitial_close_text\" || vid=\"adgain_splash_skip_text\" || vid=\"ksad_interstitial_close_outer\" || vid=\"ksad_interstitial_auto_close\" || vid=\"ksad_close_btn\" || vid=\"ksad_right_close\" || vid=\"ksad_ad_endcard_close_root\" || vid=\"ksad_detail_close_btn\" || vid=\"ksad_splash_endcard_close_img\" || vid=\"ksad_auto_close_btn\" || vid=\"mimo_interstitial_close_img\" || vid=\"mimo_template_close_img\" || vid=\"mimo_interstitial_skip\" || vid=\"hiad_banner_close_button\" || vid=\"hiad_btn_skip\" || vid=\"iv_jd_home_smile_close\" || vid=\"iv_jd_smill_close\" || vid=\"iv_jdwm_smile_close\" || vid=\"jad_video_skip_btn\" || vid=\"mimo_interstitial_endpage_close_img\" || vid=\"iv_custom_smile_close\" || vid=\"iv_didi_close\" || vid=\"iv_eleme_smile_close\" || vid=\"iv_fz_smile_close\" || vid=\"iv_idlefish_smile_close\" || vid=\"iv_ks_smile_close\" || vid=\"iv_meituan_smile_close\" || vid=\"iv_mt_hotel_smile_close\" || vid=\"iv_mt_shop_smile_close\" || vid=\"iv_mt_xh_smile_close\" || vid=\"iv_mt_yy_smile_close\" || vid=\"iv_no_show_smill_close\" || vid=\"iv_shangou_smile_close\" || vid=\"iv_smill_close\" || vid=\"iv_tb_home_smile_close\" || vid=\"iv_wph_smile_close\" || vid=\"kfc_wp_close\" || vid=\"adgain_interstitial_skip_ll\" || vid=\"adgain_interstitial_skip_text\" || vid=\"adgain_splash_skip_ll\" || vid=\"adgain_splash_skip_new_view\" || vid=\"hiad_skip_text\" || vid=\"ksad_auto_close_text\" || vid=\"ksad_banner_item_close\" || vid=\"ksad_card_close\" || vid=\"ksad_end_close_btn\" || vid=\"ksad_live_end_page_close_btn\" || vid=\"ksad_skip_view_skip\" || vid=\"ksad_splash_circle_skip_left_view\" || vid=\"ksad_splash_circle_skip_right_view\" || vid=\"ksad_splash_skip_left_view\" || vid=\"ksad_splash_skip_right_view\" || vid=\"ksad_web_tip_close_btn\" || vid=\"mimo_banner_view_close\" || vid=\"tianmu_library_close_tv\" || vid=\"tianmu_library_iv_close\" || vid=\"tianmu_library_iv_close_inside\" || vid=\"tianmu_library_iv_skip\" || vid=\"tianmu_widget_tv_skip\"][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 102,
      "name": "广告标签-返回键兜底（全 Activity）",
      // 关闭按钮读不到节点时按返回键。同样改为黑名单，避免浮层宿主不在白名单。
      // 触发条件仍要求屏幕上出现广告标签/互动引导语，action 是 back 而非 click，
      // 命中广告素材文案不会点开落地页；60 秒 / 6 次硬上限防止首页被反复退出。
      // 第十轮：删掉 text*="立即领取" 与 text*="滑动查看详情"（arsc/dex 命中属
      // 业务活动文案，删白名单后按 back 会误退首页）；text*="广告" 加长度上限，
      // 只保留 SDK 专属互动引导语（dex 中各仅 1 处）。
      "matchRoot": true,
      "forcedTime": 30000,
      "matchTime": 60000,
      "resetMatch": "activity",
      // 业务黑名单 + 启动入口（返回键退出 App）。
      "excludeActivityIds": [
        ".mvi.run",
        ".mvi.sport",
        ".mvi.indoor",
        ".mvi.ai",
        ".mvi.exam",
        ".mvi.course",
        ".mvi.home.plan",
        ".mvi.home.SportProgressActivity",
        ".activity.RunPlanActivity",
        ".hybrid.ui",
        ".mvi.tice",
        ".mvi.teachplan",
        ".mvi.roll",
        ".mvi.extra",
        ".mvi.appeal",
        ".mvi.survey",
        ".mvi.competition",
        ".mvi.notice",
        ".mvi.dynamic",
        ".mvi.me",
        ".mvi.setting",
        ".mvi.choose",
        ".mvi.register",
        ".mvi.login",
        ".mvi.tourist",
        ".mvi.wearable",
        ".activity.mine",
        ".mvi.home.InterestLabelActivity",
        ".mvi.home.RankingListActivity",
        ".mvi.home.rank",
        ".mvi.CustomWebViewActivity",
        ".mvi.WebViewActivity",
        ".mvi.WebViewGameActivity",
        ".mvi.VideoPlayActivity",
        ".mvi.FileReaderActivity",
        ".mvi.ImageViewerActivity",
        ".mvi.MultiImageSelectorActivity",
        ".hybrid.demo",
        ".utils.qrcode",
        ".wxapi",
        ".mvi.splash.SystemUpgradeActivity",
        ".mvi.splash.SplashActivity"
      ],
      "actionCd": 2500,
      "actionMaximum": 6,
      "rules": [
        {
          "key": 0,
          "action": "back",
          "matches": "[text*=\"广告\"&&text.length<=12 || desc*=\"广告\" || text*=\"上滑查看更多\" || text*=\"上滑浏览\" || text*=\"摇一摇查看\"][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 103,
      "name": "关闭文案兜底（全 Activity，业务黑名单）",
      // 第十轮：删掉 activityIds 白名单。第九轮已证明插屏是叠在宿主 Activity 上
      // 的浮层，却唯独给本组留了白名单 —— 实测 34 项只覆盖 124/330 个组件、
      // 自有 Activity 仅 4/140，泛化关闭信号在其余 136 个自有页与 41 个第三方
      // 广告容器上全部失配。改用与组 100 相同的 41 项业务黑名单后可达 194/330，
      // 误点风险由「业务页被排除 + actionCd + visibleToUser」共同约束。
      // 承接 contentDescription 含「关闭」、「N秒 | 关闭」短文案与 5 种叉号变体；
      // 刻意不含任何 *reward* 激励视频、广告落地页与下载代理。
      "excludeActivityIds": [
        ".mvi.run",
        ".mvi.sport",
        ".mvi.indoor",
        ".mvi.ai",
        ".mvi.exam",
        ".mvi.course",
        ".mvi.home.plan",
        ".mvi.home.SportProgressActivity",
        ".activity.RunPlanActivity",
        ".hybrid.ui",
        ".mvi.tice",
        ".mvi.teachplan",
        ".mvi.roll",
        ".mvi.extra",
        ".mvi.appeal",
        ".mvi.survey",
        ".mvi.competition",
        ".mvi.notice",
        ".mvi.dynamic",
        ".mvi.me",
        ".mvi.setting",
        ".mvi.choose",
        ".mvi.register",
        ".mvi.login",
        ".mvi.tourist",
        ".mvi.wearable",
        ".activity.mine",
        ".mvi.home.InterestLabelActivity",
        ".mvi.home.RankingListActivity",
        ".mvi.home.rank",
        ".mvi.CustomWebViewActivity",
        ".mvi.WebViewActivity",
        ".mvi.WebViewGameActivity",
        ".mvi.VideoPlayActivity",
        ".mvi.FileReaderActivity",
        ".mvi.ImageViewerActivity",
        ".mvi.MultiImageSelectorActivity",
        ".hybrid.demo",
        ".utils.qrcode",
        ".wxapi",
        ".mvi.splash.SystemUpgradeActivity"
      ],
      "matchRoot": true,
      "forcedTime": 30000,
      "actionCd": 1500,
      // 不加 matchTime / actionMaximum / resetMatch：弹窗随时可能出现。
      // desc 分支不符合 fastQuery 规定格式，本组刻意不开 fastQuery。
      "rules": [
        {
          "key": 0,
          "matches": "[desc*=\"关闭\" || text*=\"关闭\"&&text.length<=8 || text=\"×\" || text=\"✕\" || text=\"✖\" || text=\"✗\" || text=\"╳\"][visibleToUser=true]"
        }
      ]
    }
  ]
  // === END OF FILE === 粘贴前确认能看到本行，看不到就说明内容被截断了，请重新复制。
  // 更稳妥的做法是用订阅链接导入（见 README.md），完全不需要粘贴文本。
}
