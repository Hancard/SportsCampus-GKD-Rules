// ============================================================================
// 运动世界校园 7.3.93 (com.zjwh.android_wh_physicalfitness) —— GKD 本地应用规则
//
// 导入：GKD → 订阅 → 本地订阅 → 应用规则 → + ，整段粘贴
// 用途：补齐广告页的关闭按钮，以及开屏「跳过」文本兜底。
// 前提：安装 GKD 并开启无障碍；建议同时导入续更订阅
//       Lin-arm/GKD_subscription，并关闭其 key 13 / 14 / 15（见 README.md）。
// 说明：若订阅已能跳掉全部广告，不必导入本文件，避免两个规则源重复点击。
// 回退：关闭本规则组，或关掉 GKD 无障碍开关。
//
// 组件名与资源 ID 均对照 7.3.93 完整 AndroidManifest.xml（330 个 activity）
// 与 resources.arsc 核实。activityIds / excludeActivityIds 是 startWith 匹配；
// 以 "." 开头会自动补全为 appId + 该字符串。
//
// 红线：不接触跑步计时、轨迹、成绩与定位页面；不用硬编码屏幕坐标；不用跨应用
//       全局规则；返回键兜底组只在广告容器白名单内生效且严格限流。
// ============================================================================

{
  "id": "com.zjwh.android_wh_physicalfitness",
  "name": "运动世界校园 7.3.93 补充",
  "groups": [
    {
      "key": 100,
      "name": "开屏广告-跳过按钮兜底",
      // 社区常用的开屏跳过选择器，限定在本 App 内。
      // 10 秒匹配窗口 + 每次进入 App 最多点 1 次，防止在首页反复误点。
      // 显式排除跑步/成绩/考试/定位等核心页面，这些页面可能出现「跳过」字样，
      // 但绝不能被自动点击。
      "excludeActivityIds": [
        ".mvi.run",
        ".mvi.sport",
        ".mvi.indoor",
        ".mvi.ai",
        ".mvi.exam",
        ".mvi.course",
        ".mvi.home.plan",
        ".mvi.home.SportProgressActivity",
        ".activity.RunPlanActivity",
        ".hybrid.ui"
      ],
      "fastQuery": true,
      "matchTime": 10000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"跳过\"][text.length<10][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 101,
      "name": "全屏/插屏广告-关闭按钮（限广告容器）",
      // 下面组件名均来自本包 AndroidManifest 静态解析。
      // SplashActivity / HomeActivity 是开屏与首页弹窗广告的宿主（业务页面，
      // 不是纯广告页），其余为各广告 SDK 的容器。
      // 不含激励视频/奖励页，不含任何跑步、成绩、定位页面。
      // 本包 Pangle 壳是 com.byazt.cef.Stub_*（7 个），不是标准的
      // com.bytedance.sdk.openadsdk.stub.activity.* —— 后者在本包中不存在。
      // 末尾 5 个是京东 JAD / 天目 / AdGain 的插屏与透明容器。
      // 2026-11-09 真机截图反馈：首页「京东 JD 60 元券 / 上滑查看详情」的
      // 互动插屏广告（对应 assets/jad_slideup.json）由京东 SDK 承载，
      // 其关闭按钮 vid 是 jad_interstitial_close / jd_lijin_close。
      "activityIds": [
        ".mvi.splash.SplashActivity",
        ".mvi.splash.AdActivity",
        ".mvi.home.HomeActivity",
        "com.yfanads.android.core.act.YFInterstitialActivity",
        "com.yfanads.android.adx.components.fullscreen.AdxFullScreenVideoActivity",
        "com.yfanads.android.adx.core.TransparentActivity",
        "com.yfanads.android.adx.core.DialogProxyActivity",
        "com.yfanads.android.adx.webview.AdxWebViewActivity",
        "com.qq.e.ads.ADActivity",
        "com.qq.e.ads.PortraitADActivity",
        "com.qq.e.ads.LandscapeADActivity",
        "com.qq.e.ads.DialogActivity",
        "com.byazt.cef.Stub_",
        "com.kwad.sdk.api.proxy.app.AdWebViewActivity",
        "com.jd.ad.sdk.bl.adinteraction.deeplink.JADTransparentActivity",
        "com.jd.ad.sdk.bl.adinteraction.deeplink.JADWebViewActivity",
        "com.tianmu.biz.activity.InterstitialActivity",
        "com.tianmu.biz.activity.LandscapeInterstitialActivity",
        "com.adgain.sdk.base.activity.AdActivity"
      ],
      "actionCd": 1500,
      "rules": [
        {
          // 单条规则同时覆盖「按 vid 匹配」与「按 contentDescription 兜底」。
          // 2026-11-10 修复：此前拆成 key 0 / key 1 两条 rule，一个关闭按钮若
          // 同时有 vid 和 desc 含「关闭」，两条 rule 会各点一次 —— 连点两下，
          // 第二次坐标可能已经落在广告素材上，反而打开落地页。合并后不可能重复触发。
          //
          // 这里刻意不写 fastQuery：官方 optimize#rule-format 规定快速查询只接受
          // id/vid/text 系列作为 || 分支，desc*="关闭" 不符合；「只要有一个分支
          // 不符合, 整个 || 表达式就必须停用全局快速查询」。此前 key 1 上的
          // fastQuery:true 因此完全无效（官方：不满足格式时开不开都不影响查询
          // 复杂度），是误导性配置。正确性优先，保留全树遍历。
          //
          // 所有 vid 均用 _probe/62_arsc_idtype.py 核实为本包 resources.arsc 中
          // type=id 的真实资源名（4865 个 id 里逐个查得）；只收录广告 SDK 专属
          // 前缀，不收 btn_close / img_close / tv_close 这类业务页面常见通用名。
          // 注意 jad_interstitial_close_view / jad_back_close 只是 layout 名，
          // 不是 id，写进 vid 会永不触发。
          //
          // 2026-11-09 二次修复：末尾的 [clickable=true] 是错误约束。官方
          // RawRuleProps 明确 action 默认 "click" 会自动判断：clickable 用
          // clickNode，否则降级 clickCenter；clickNode 未被接收也会回落
          // clickCenter。京东自定义关闭 View 常把点击交给父容器或 onTouch，
          // isClickable() 为 false，加该条件会把它们整批筛掉。现只用
          // [visibleToUser=true] 排除不可见节点，不限制点击实现方式。
          "key": 0,
          "matches": "[vid=\"iv_close\" || vid=\"ad_close\" || vid=\"dialog_close\" || vid=\"jad_interstitial_close\" || vid=\"jd_lijin_close\" || vid=\"jd_close\" || vid=\"adgain_interstitial_close_ll\" || vid=\"ksad_interstitial_close_outer\" || vid=\"tianmu_suspend_iv_close\" || desc*=\"关闭\"][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 102,
      "name": "广告标签-返回键兜底",
      // 触发条件是屏幕上出现「广告」标签（京东 / 穿山甲插屏右下角都有），
      // 用于上面两组都读不到关闭按钮节点时的最后兜底。
      // 2026-11-09 二次修复：改为默认启用。此前 enable:false 让京东礼金互动
      // 插屏在关闭按钮读不到节点时完全没有兜底，真机反馈仍有广告。
      //
      // 2026-11-10 修复参数矛盾：此前 actionCd 8000 与 matchTime 8000 相等。
      // 官方 RawCommonProps 定义：matchTime 是「规则参与查询屏幕节点时，等待
      // 一段时间后休眠此规则」，actionCd 是「执行 action 最小间隔」。两者都取
      // 8000 且 resetMatch=app（只有重新进入 App 才唤醒），意味着第一次返回键
      // 之后规则已进入 8 秒冷却，而 8 秒窗口同时耗尽 → 第二次永远不可能执行，
      // actionMaximum:2 是死配置，注释/README 声称「最多按 2 次」与实现不符。
      // 现把 actionCd 降到 2500，让 2 次返回键在 8 秒窗口内真正可达；若第一次
      // 已关掉广告，节点消失，第二次自然不会触发。
      // ⚠️ activityIds 含 .mvi.home.HomeActivity：首页浮层若不消费返回键，
      //    按返回键可能退出首页（只影响当前页面，不影响计时/轨迹/成绩）。
      //    仍有 matchTime 8000 + actionMaximum 2 + resetMatch app 限流。
      //    若实测发现误退出，在 GKD 界面里直接关掉本组即可，无需改文件。
      "matchTime": 8000,
      "resetMatch": "app",
      "activityIds": [
        "com.yfanads.android.adx.components.fullscreen.AdxFullScreenVideoActivity",
        "com.byazt.cef.Stub_",
        "com.jd.ad.sdk.bl.adinteraction.deeplink.JADTransparentActivity",
        "com.tianmu.biz.activity.InterstitialActivity",
        "com.tianmu.biz.activity.LandscapeInterstitialActivity",
        "com.adgain.sdk.base.activity.AdActivity",
        ".mvi.home.HomeActivity"
      ],
      "actionCd": 2500,
      "actionMaximum": 2,
      "rules": [
        {
          // 部分 SDK 把「广告」放在 contentDescription 而不是 text，一并覆盖。
          "key": 0,
          "action": "back",
          "matches": "[text=\"广告\" || desc=\"广告\"][visibleToUser=true]"
        }
      ]
    }
  ]
  // === END OF FILE === 粘贴前确认能看到本行，看不到就说明内容被截断了，请重新复制。
  // 更稳妥的做法是用订阅链接导入（见 README.md），完全不需要粘贴文本。
}
